[Unit]
Description=LocalFlow offline task control plane
After=local-fs.target

[Service]
Type=simple
User=localflow
Group=localflow
Environment=LOCALFLOW_WEB_DIST=/opt/localflow/frontend/dist
ExecStart=/opt/localflow/venv/bin/localflow serve --root /var/lib/localflow
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/localflow
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
